# Pharos Network - required for onchain mode only
# Leave blank to run in local/simulated mode
PHAROS_PRIVATE_KEY=

# Address of deployed BudgetOracleLogger contract on Pharos
# Deploy skills/onchain-ledger/scripts/BudgetOracleLogger.sol first, then paste the address here
BUDGET_ORACLE_CONTRACT=

# Optional: mainnet or testnet. Defaults to mainnet.
# testnet aliases: testnet, atlantic, atlantic-testnet
PHAROS_NETWORK=mainnet

# Optional: override selected network RPC
# mainnet default: https://rpc.pharos.xyz
# testnet default: https://atlantic.dplabs-internal.com
PHAROS_RPC_URL=
