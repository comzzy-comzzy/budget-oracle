# Pharos Network - required for onchain mode only
# Leave blank to run in local/simulated mode
PHAROS_PRIVATE_KEY=

# Address of deployed BudgetOracleLogger contract on Pharos
# Deploy skills/onchain-ledger/scripts/BudgetOracleLogger.sol first, then paste the address here
BUDGET_ORACLE_CONTRACT=

# Optional: override Pharos RPC (default: https://rpc.pharos.network)
PHAROS_RPC_URL=
